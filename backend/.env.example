# Supabase 프로젝트 설정 (Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# 게임 서버는 service_role key 사용 (RLS 우회, 절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# service_role key가 없을 때의 임시 fallback (RLS 활성화 후에는 동작 안 함)
SUPABASE_ANON_KEY=your-anon-key

# CORS 허용 origin (콤마로 여러 개 지정 가능)
# 예: https://your-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# 서버 포트 (Render는 자동 주입하므로 로컬에서만 필요)
PORT=4000
