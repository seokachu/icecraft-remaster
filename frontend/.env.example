# Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Socket.IO 게임 서버 (백엔드는 /mafia 네임스페이스 사용)
NEXT_PUBLIC_SOCKET_SERVER_URL=http://localhost:4000/mafia

# 선택: TURN 릴레이 (NAT 환경에서 P2P가 막힐 때 필요 — 예: Metered Open Relay)
# NEXT_PUBLIC_TURN_URL=turn:your-turn-server:443
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=

# 배포/로컬 기준 URL (https:// 포함한 전체 URL이어야 함)
NEXT_PUBLIC_VERCEL_URL=https://your-app.vercel.app
NEXT_PUBLIC_DEV_CLIENT_URL=http://localhost:3000

# 선택: EmailJS 문의 폼
NEXT_PUBLIC_EMAIL_SERVICE_ID=
NEXT_PUBLIC_EMAIL_TEMPLATE_ID=
NEXT_PUBLIC_EMAIL_PUBLIC_KEY=

# 선택: Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS=
